def node_require(script)
  # Resolve script with node to allow for hoisting
  require Pod::Executable.execute_command('node', ['-p',
    "require.resolve(
      '#{script}',
      {paths: [process.argv[1]]},
    )", __dir__]).strip
end

node_require('react-native/scripts/react_native_pods.rb')
node_require('react-native-permissions/scripts/setup.rb')

platform :ios, min_ios_version_supported
prepare_react_native_project!

# react-native-permissions ships each permission type as an opt-in subspec so
# unused ones don't bloat the binary — enable only the ones this app actually
# requests (see src/utils/permissions.ts).
setup_permissions([
  'Contacts',
  'LocationWhenInUse',
  'Camera',
  'PhotoLibrary',
  'Microphone',
])

# Always build pods as frameworks (static by default, override with
# USE_FRAMEWORKS=dynamic if ever needed) — AppDelegate.swift's
# `import react_native_orientation_locker` only resolves as a Swift module
# under frameworks linkage. Making this unconditional means a plain
# `pod install` on any machine produces a working build, instead of relying
# on everyone remembering to set USE_FRAMEWORKS first.
linkage = ENV['USE_FRAMEWORKS'] || 'static'
Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
use_frameworks! :linkage => linkage.to_sym

target 'KLESPrescriptionDiary' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
  end
end
