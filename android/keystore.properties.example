# Copy this file to android/keystore.properties (git-ignored) and fill it in
# with the EXISTING production keystore used to sign the already-published
# com.KlesPrescription app — do NOT generate a new one, or Play Store updates
# will be rejected as a signature mismatch.
#
# 1. Copy your existing .keystore/.jks file to android/app/release.keystore
# 2. Fill these in (storeFile is relative to the android/ directory):
storeFile=app/release.keystore
storePassword=
keyAlias=
keyPassword=
